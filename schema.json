{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/canopico-world/PhenoVoxel-Archive/schema.json",
  "title": "PhenoVoxel Archive snapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "title",
    "updated",
    "licenses",
    "methodology",
    "species"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "licenses": {
      "type": "object",
      "required": [
        "code",
        "originalData",
        "externalSources"
      ],
      "properties": {
        "code": {
          "const": "MIT"
        },
        "originalData": {
          "const": "CC-BY-4.0"
        },
        "externalSources": {
          "type": "string"
        }
      }
    },
    "methodology": {
      "type": "string"
    },
    "species": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/species"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "species": {
      "type": "object",
      "required": [
        "id",
        "scientificName",
        "commonName",
        "group",
        "domain",
        "family",
        "habitat",
        "range",
        "nutrition",
        "summary",
        "anatomy",
        "behaviors",
        "sources",
        "visual",
        "review",
        "taxonomy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)+$"
        },
        "scientificName": {
          "type": "string"
        },
        "commonName": {
          "type": "string"
        },
        "group": {
          "enum": [
            "Animalia",
            "Plantae",
            "Fungi",
            "Microeukaryotes",
            "Bacteria",
            "Archaea"
          ]
        },
        "domain": {
          "enum": [
            "Eukaryota",
            "Bacteria",
            "Archaea"
          ]
        },
        "family": {
          "type": "string"
        },
        "habitat": {
          "type": "string"
        },
        "range": {
          "type": "string"
        },
        "nutrition": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "anatomy": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "behaviors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/behavior"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "visual": {
          "type": "object",
          "required": [
            "kind",
            "variant",
            "color",
            "fidelity",
            "scale"
          ],
          "properties": {
            "kind": {
              "enum": [
                "quadruped",
                "kangaroo",
                "ape",
                "cetacean",
                "bird",
                "penguin",
                "turtle",
                "reptile",
                "salamander",
                "frog",
                "fish",
                "octopus",
                "insect",
                "butterfly",
                "worm",
                "jelly",
                "plant",
                "tree",
                "mushroom",
                "cell",
                "network"
              ]
            },
            "variant": {
              "type": "string"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "fidelity": {
              "type": "string"
            },
            "scale": {
              "type": "string"
            }
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "animationValidated"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "animationValidated": {
              "type": "boolean"
            }
          }
        },
        "taxonomy": {
          "type": "object",
          "required": [
            "provider"
          ],
          "properties": {
            "provider": {
              "type": "string"
            },
            "checked": {
              "type": "string",
              "format": "date"
            },
            "usageKey": {
              "type": "integer"
            },
            "acceptedUsageKey": {
              "type": "integer"
            },
            "canonicalName": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "kingdom": {
              "type": "string"
            },
            "phylum": {
              "type": "string"
            },
            "class": {
              "type": "string"
            },
            "order": {
              "type": "string"
            },
            "family": {
              "type": "string"
            },
            "genus": {
              "type": "string"
            },
            "matchType": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "note": {
              "type": "string"
            }
          }
        },
        "photograph": {
          "type": "object",
          "required": [
            "localFile",
            "source",
            "author",
            "license",
            "licenseUrl",
            "retrieved"
          ],
          "properties": {
            "localFile": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "format": "uri"
            },
            "author": {
              "type": "string"
            },
            "license": {
              "type": "string"
            },
            "licenseUrl": {
              "type": "string",
              "format": "uri"
            },
            "retrieved": {
              "type": "string",
              "format": "date"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "occurrences": {
          "type": "object",
          "required": [
            "taxonKey",
            "count",
            "query",
            "source",
            "retrieved"
          ],
          "properties": {
            "taxonKey": {
              "type": "integer"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "query": {
              "type": "string",
              "format": "uri"
            },
            "source": {
              "type": "string",
              "format": "uri"
            },
            "retrieved": {
              "type": "string",
              "format": "date"
            },
            "countries": {
              "type": "array"
            }
          }
        },
        "modelAsset": {
          "type": "object",
          "required": [
            "author",
            "source",
            "license",
            "delivery",
            "biology",
            "localFile",
            "sha256",
            "clips",
            "rigged"
          ],
          "properties": {
            "author": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "format": "uri"
            },
            "license": {
              "type": "string"
            },
            "licenseUrl": {
              "type": "string",
              "format": "uri"
            },
            "localFile": {
              "type": "string",
              "pattern": "^model-[a-z-]+\\.glb$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "clips": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rigged": {
              "type": "boolean"
            },
            "surfaceType": {
              "type": "string"
            },
            "delivery": {
              "type": "string"
            },
            "biology": {
              "type": "string"
            },
            "viewerRig": {
              "type": "object",
              "required": [
                "type",
                "author",
                "version",
                "jointsPerMesh",
                "animationValidated",
                "scope"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "author": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "jointsPerMesh": {
                  "type": "integer",
                  "minimum": 1
                },
                "animationValidated": {
                  "const": false
                },
                "scope": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "behavior": {
      "type": "object",
      "required": [
        "id",
        "label",
        "description",
        "sourceIds",
        "evidence",
        "timeScale"
      ],
      "properties": {
        "id": {
          "enum": [
            "walk",
            "run",
            "jump",
            "sleep",
            "rest",
            "forage",
            "escape",
            "swim",
            "fly",
            "crawl",
            "pulse",
            "grow",
            "fold",
            "trap",
            "unfurl",
            "bud",
            "spread",
            "glide",
            "phototaxis",
            "tumble",
            "reverse",
            "sit",
            "stretch",
            "shift"
          ]
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "string"
        },
        "timeScale": {
          "type": "string"
        },
        "rendering": {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "available",
                "partial",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "scope",
        "accessed"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "scope": {
          "type": "string"
        },
        "accessed": {
          "type": "string",
          "format": "date"
        },
        "type": {
          "type": "string"
        },
        "retrieval": {
          "type": "object"
        },
        "verification": {
          "type": "object"
        }
      }
    }
  }
}
